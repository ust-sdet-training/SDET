{
  "name": "playwright_final_capstone",
  "version": "1.0.0",
  "description": "Playwright + TypeScript framework for the TripStack flight booking flow",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:performance": "playwright test --project=chromium --grep @performance",
    "typecheck": "tsc --project tsconfig.json --noEmit --ignoreDeprecations 5.0",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^16.4.2",
    "typescript": "^5.9.3"
  }
}
