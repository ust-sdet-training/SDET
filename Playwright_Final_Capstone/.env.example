BASE_URL=https://tripstack.doomple.com/
HEADLESS=true
SLOW_MO=0

# E07 / Chandana. Keep real values only in your untracked .env locally and
# in GitHub Actions secrets in CI. Do not copy values from a local .env here.
TRIPSTACK_EMAIL=
TRIPSTACK_PASSWORD=

# Optional dynamic passenger naming for generated data.
PASSENGER_FIRST_NAME_PREFIX=Test
PASSENGER_LAST_NAME_PREFIX=User

# A regression gate for the E07 seat-map render. Set this from a measured
# baseline during the Day-6 performance session.
SEAT_MAP_MAX_RENDER_MS=5000
