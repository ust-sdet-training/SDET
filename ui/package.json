{
  "name": "tripstack-ui-capstone",
  "version": "1.0.0",
  "description": "TripStack Playwright capstone suite for the Lakhan booking scenario",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:ci": "playwright test tests/tripstack-bus-booking.spec.ts tests/tripstack-negative.spec.ts --project=chromium --workers=1 --reporter=line,html",
    "show-trace": "playwright show-trace",
    "show-report": "playwright show-report",
    "artifact-index": "node ./scripts/build-artifact-index.js",
    "api:contract": "node ./scripts/api-contract-smoke.cjs",
    "perf:baseline": "node ./scripts/perf-baseline.cjs",
    "perf:check": "node ./scripts/perf-check.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "winston": "^3.10.0"
  }
}
